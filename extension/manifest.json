{
  "manifest_version": 3,
  "name": "Job Tracker",
  "version": "0.2.0",
  "description": "Search jobs, track applications, and have application forms filled in with your profile and resume. You review and submit.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting"],
  "host_permissions": ["https://jsearch.p.rapidapi.com/*", "https://remotive.com/*", "https://www.arbeitnow.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Job Tracker",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "fill-page": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill the application form on this page"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.workable.com/*"
      ],
      "js": ["content/fieldMap.js", "content/autofill.js", "content/auto.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
